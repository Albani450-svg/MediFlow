{
  "name": "mediflow",
  "version": "0.1.0",
  "description": "PWA antrean poliklinik, rekam medis, dan e-resep MediFlow.",
  "scripts": {
    "api": "node scripts/start-api.mjs",
    "dev": "vite --open",
    "build": "tsc && vite build",
    "check": "node scripts/run-check.mjs",
    "dummy": "node scripts/isi-dummy.mjs",
    "start": "npm run dev",
    "start-remote": "vite --host"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lit": "^3.3.3",
    "qrcode": "^1.5.4",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "consistent",
    "trailingComma": "es5",
    "endOfLine": "crlf",
    "bracketSpacing": true
  }
}
