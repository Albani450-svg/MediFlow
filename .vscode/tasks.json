{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "jalankan",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run-application.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MEDIFLOW_TANPA_BROWSER": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "\\[mediflow\\] Aplikasi Java di"
        }
      }
    },
    {
      "label": "postdebugKill",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run-application.ps1",
        "henti"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
