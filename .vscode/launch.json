{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "msedge",
      "request": "launch",
      "name": "Run PWA",
      "webRoot": "${workspaceFolder}/",
      "runtimeArgs": ["--app=http://127.0.0.1:5173"],
      "sourceMapPathOverrides": {
        "../../src": "${workspaceFolder}/src",
        "../../src/*": "${workspaceFolder}/src/*"
      },
      "preLaunchTask": "npm run dev",
      "postDebugTask": "postdebugKill"
    }
  ]
}
